GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
ADMIN_USERNAME=<unique_admin_username>
ADMIN_PASSWORD_HASH=<argon2id_password_hash>
# Configure a reverse proxy to strip client-supplied headers, add both headers below,
# and keep Streamlit inaccessible directly from the public internet.
ADMIN_TRUSTED_CLIENT_ID_HEADER=X-CivicAI-Client-ID
ADMIN_TRUSTED_PROXY_AUTH_HEADER=X-CivicAI-Proxy-Auth
ADMIN_TRUSTED_PROXY_AUTH_VALUE=<unique_proxy_shared_secret>
# Private directory outside the project tree and OneDrive. The service account must own it.
CIVICAI_UPLOAD_DIR=<private_upload_directory_outside_project_and_onedrive>
# Absolute private SQLite path outside the project, OneDrive/cloud-sync, and static-serving directories.
CIVICAI_DB_PATH=<absolute_private_sqlite_database_path>
